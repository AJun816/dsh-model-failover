{
  "name": "dsh-model-failover",
  "description": "DeepSeek Harness plugin: automatic model & account failover across providers when quota runs out — near-zero dependencies",
  "version": "0.3.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["lib/index.js", "lib/index.d.ts", "lib/client.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "keywords": ["deepseek-harness", "dsh", "failover", "llm", "glm", "quota"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJun816/dsh-model-failover.git"
  },
  "bugs": {
    "url": "https://github.com/AJun816/dsh-model-failover/issues"
  },
  "homepage": "https://github.com/AJun816/dsh-model-failover#readme",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node ./node_modules/esbuild/bin/esbuild src/client.tsx --bundle --format=esm --platform=browser --jsx=automatic --outfile=lib/client.js --external:react --external:react/jsx-runtime --external:react-dom --external:react-dom/client --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-client-ui-slots",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/loader.mjs --test ./test/index.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
